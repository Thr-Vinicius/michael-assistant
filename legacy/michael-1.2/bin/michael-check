#!/usr/bin/env bash
set -euo pipefail

source "$HOME/.local/share/michael/scripts/config.sh"

FAILS=0
WARNINGS=0

ok() {
    printf '✅ %s\n' "$1"
}

warn() {
    WARNINGS=$((WARNINGS + 1))
    printf '⚠️  %s\n' "$1"
}

fail() {
    FAILS=$((FAILS + 1))
    printf '❌ %s\n' "$1"
}

svc_active() {
    systemctl --user is-active "$1" 2>/dev/null || true
}

svc_enabled() {
    systemctl --user is-enabled "$1" 2>/dev/null || true
}

check_cmd() {
    local cmd="$1"

    if command -v "$cmd" >/dev/null 2>&1; then
        ok "Comando encontrado: $cmd"
    else
        fail "Comando ausente: $cmd"
    fi
}

check_any_cmd() {
    local label="$1"
    shift

    local found=""

    for cmd in "$@"; do
        if command -v "$cmd" >/dev/null 2>&1; then
            found="$cmd"
            break
        fi
    done

    if [[ -n "$found" ]]; then
        ok "$label disponível: $found"
    else
        fail "$label indisponível: nenhum encontrado ($*)"
    fi
}

check_exec() {
    local file="$1"

    if [[ -x "$file" ]]; then
        ok "Script executável: $file"
    elif [[ -f "$file" ]]; then
        fail "Script existe, mas não está executável: $file"
    else
        fail "Script ausente: $file"
    fi
}

check_file() {
    local file="$1"
    local label="$2"

    if [[ -f "$file" ]]; then
        ok "$label encontrado: $file"
    else
        warn "$label não encontrado: $file"
    fi
}

echo
echo "Michael Check"
echo "============="
echo

VOICE_ACTIVE="$(svc_active michael-voice.service)"
VOICE_ENABLED="$(svc_enabled michael-voice.service)"

OLD_ACTIVE="$(svc_active jarvis-wakeword.service)"
OLD_ENABLED="$(svc_enabled jarvis-wakeword.service)"

CLAP_ACTIVE="$(svc_active michael-clap.service)"
CLAP_ENABLED="$(svc_enabled michael-clap.service)"

if [[ "$VOICE_ACTIVE" == "active" ]]; then
    ok "Voz principal ativa"
else
    fail "Voz principal não está ativa: $VOICE_ACTIVE"
fi

if [[ "$VOICE_ENABLED" == "enabled" ]]; then
    ok "Voz principal habilitada no boot"
else
    warn "Voz principal não está enabled: $VOICE_ENABLED"
fi

if [[ "$OLD_ACTIVE" == "inactive" || "$OLD_ACTIVE" == "failed" || -z "$OLD_ACTIVE" ]]; then
    ok "Voz antiga/Jarvis não está rodando"
else
    fail "Voz antiga/Jarvis ainda está rodando: $OLD_ACTIVE"
fi

if [[ "$CLAP_ACTIVE" == "inactive" || "$CLAP_ACTIVE" == "failed" || -z "$CLAP_ACTIVE" ]]; then
    ok "Palmas não estão rodando"
else
    fail "Serviço de palmas ainda está rodando: $CLAP_ACTIVE"
fi

VOICE_PROCS="$(pgrep -af 'michael_voice.py|jarvis_wakeword.py|clap_setup.py' || true)"
VOICE_PROC_COUNT="$(printf '%s\n' "$VOICE_PROCS" | sed '/^$/d' | wc -l)"

if [[ "$VOICE_PROC_COUNT" -eq 1 ]] && printf '%s\n' "$VOICE_PROCS" | grep -q "michael_voice.py"; then
    ok "Apenas um processo de voz rodando"
else
    fail "Quantidade/processo de voz inesperado: $VOICE_PROC_COUNT"
    printf '%s\n' "$VOICE_PROCS"
fi

echo
echo "Scripts"
echo "-------"

check_exec "$HOME/.local/bin/michael-setup-request"
check_exec "$HOME/.local/bin/abrir-setup"
check_exec "$HOME/.local/bin/michael-voice-command"
check_exec "$HOME/.local/bin/michael-status"
check_exec "$HOME/.local/bin/michael-welcome"
check_exec "$HOME/.local/bin/michael-musica"
check_exec "$HOME/.local/bin/michael-video"
check_exec "$HOME/.local/bin/michael-ajuda"
check_exec "$HOME/.local/bin/michael-volume"
check_exec "$HOME/.local/bin/michael-mudar"
check_exec "$HOME/.local/bin/michael-tempo"
check_exec "$HOME/.local/bin/michael-agenda"
check_exec "$HOME/.local/bin/michael-desligar"
check_exec "$HOME/.local/bin/michael-desligar-teste"

echo
echo "Dependências"
echo "------------"

check_cmd hyprctl
check_cmd jq
check_cmd ydotool
check_any_cmd "Player de áudio" mpv ffplay paplay
check_any_cmd "Controle de volume" wpctl pactl amixer

echo
echo "Permissões"
echo "----------"

if sudo -n /usr/bin/pacman --version >/dev/null 2>&1; then
    ok "NOPASSWD para pacman funcionando"
else
    fail "NOPASSWD para pacman não está funcionando"
fi

echo
echo "Áudios"
echo "------"

check_file "$HOME/audios-michael/inic.mp3" "Áudio inicial"
check_file "$HOME/audios-michael/conf_1_som.mp3" "Som de ativação"
check_file "$HOME/audios-michael/boas_vindas_senhor_pronto_para_mais_um_dia.mp3" "Boas-vindas"
check_file "$HOME/audios-michael/deslig.mp3" "Áudio de desligamento futuro"

echo
echo "Vosk"
echo "----"

if [[ -d "$HOME/vosk-model" ]]; then
    ok "Modelo Vosk encontrado"
else
    fail "Modelo Vosk não encontrado em $HOME/vosk-model"
fi

echo
echo "Estado"
echo "------"

if is_paused; then
    warn "Michael está pausado"
else
    ok "Michael não está pausado"
fi

if has_pending; then
    warn "Existe setup pendente antigo"
else
    ok "Nenhum setup pendente"
fi

if apps_open; then
    ok "Apps/setup detectados como abertos"
else
    ok "Apps/setup detectados como fechados"
fi

echo
echo "Resumo"
echo "------"

if [[ "$FAILS" -eq 0 && "$WARNINGS" -eq 0 ]]; then
    SUMMARY="Tudo certo ✅"
elif [[ "$FAILS" -eq 0 ]]; then
    SUMMARY="$WARNINGS aviso(s), sem erro crítico ⚠️"
else
    SUMMARY="$FAILS erro(s), $WARNINGS aviso(s) ❌"
fi

echo "$SUMMARY"

notify_basic "Michael Check" "$SUMMARY"
log_michael "check executado: fails=$FAILS warnings=$WARNINGS resumo=$SUMMARY"
