#!/usr/bin/env bash

set -u

FAILS=0
WARNS=0

ok() {
    printf '✅ %s\n' "$*"
}

warn() {
    WARNS=$((WARNS + 1))
    printf '⚠️  %s\n' "$*"
}

fail() {
    FAILS=$((FAILS + 1))
    printf '❌ %s\n' "$*"
}

section() {
    printf '\n%s\n' "$1"
    printf '%s\n' "$(printf '%*s' "${#1}" '' | tr ' ' '-')"
}

unit_active() {
    systemctl --user is-active "$1" 2>/dev/null | head -n 1 || true
}

unit_enabled() {
    systemctl --user is-enabled "$1" 2>/dev/null | head -n 1 || true
}

check_executable() {
    local path="$1"

    if [ -x "$path" ]; then
        ok "Executável: $path"
    elif [ -e "$path" ]; then
        fail "Existe, mas não está executável: $path"
    else
        fail "Não encontrado: $path"
    fi
}

check_file() {
    local path="$1"

    if [ -f "$path" ]; then
        ok "Arquivo encontrado: $path"
    else
        fail "Arquivo não encontrado: $path"
    fi
}

check_command() {
    local cmd="$1"

    if command -v "$cmd" >/dev/null 2>&1; then
        ok "Comando encontrado: $cmd"
    else
        fail "Comando ausente: $cmd"
    fi
}

echo "Michael 2.0 Minimal Stable - Check"
echo "=================================="
echo "Data: $(date)"

section "Serviços"

voice_active="$(unit_active michael-voice.service)"
voice_enabled="$(unit_enabled michael-voice.service)"

if [ "$voice_active" = "active" ]; then
    ok "Voz principal ativa"
else
    fail "Voz principal não está ativa: ${voice_active:-desconhecido}"
fi

if [ "$voice_enabled" = "enabled" ]; then
    ok "Voz principal habilitada no boot"
else
    warn "Voz principal não está habilitada no boot: ${voice_enabled:-desconhecido}"
fi

jarvis_active="$(unit_active jarvis-wakeword.service)"
clap_active="$(unit_active michael-clap.service)"

if [ "$jarvis_active" = "active" ]; then
    fail "Voz antiga/Jarvis ainda está rodando"
else
    ok "Voz antiga/Jarvis não está rodando"
fi

if [ "$clap_active" = "active" ]; then
    fail "Palmas ainda estão rodando"
else
    ok "Palmas não estão rodando"
fi

section "Processos"

voice_processes="$(pgrep -af 'michael_voice.py' 2>/dev/null || true)"
voice_count="$(printf '%s\n' "$voice_processes" | sed '/^$/d' | wc -l)"

if [ "$voice_count" -eq 1 ]; then
    ok "Apenas um processo michael_voice.py rodando"
else
    fail "Quantidade inesperada de processos michael_voice.py: $voice_count"
fi

if [ -n "$voice_processes" ]; then
    printf '%s\n' "$voice_processes"
fi

section "Scripts ativos"

check_executable "$HOME/.local/bin/michael"
check_executable "$HOME/.local/bin/michael-router"
check_executable "$HOME/.local/bin/michael-voice-command"
check_executable "$HOME/.local/bin/michael-ajuda"
check_executable "$HOME/.local/bin/michael-status"
check_executable "$HOME/.local/bin/michael-ouviu"
check_executable "$HOME/.local/bin/michael-check"
check_executable "$HOME/.local/bin/michael-resolver"

check_executable "$HOME/.local/bin/michael-setup-request"
check_executable "$HOME/.local/bin/abrir-setup"
check_executable "$HOME/.config/hypr/scripts/abrir-wa-yt.sh"


section "Arquivos principais"

check_file "$HOME/michael_voice.py"
check_file "$HOME/.local/share/michael/scripts/config.sh"

section "Dependências"

check_command bash
check_command python3
check_command systemctl
check_command flock
check_command notify-send
check_command hyprctl
check_command jq
check_command pactl
check_command playerctl
check_command ydotool

section "Router"

if [ -x "$HOME/.local/bin/michael-router" ]; then
    ok "Router está executável"

    if [ "${MICHAEL_SOURCE:-manual}" != "manual" ] || [ "${MICHAEL_CHECK_SKIP_ROUTER_SELFTEST:-0}" = "1" ]; then
        ok "Self-test do router pulado para evitar chamada recursiva com lock"
    else
        if "$HOME/.local/bin/michael-router" --dry-run "Michael música" 2>/dev/null | grep -qi "removido"; then
            ok "Comando removido bloqueado corretamente: música"
        else
            fail "Router não bloqueou corretamente: música"
        fi

        if "$HOME/.local/bin/michael-router" --dry-run "Michael previsão do tempo" 2>/dev/null | grep -qi "removido"; then
            ok "Comando removido bloqueado corretamente: previsão do tempo"
        else
            fail "Router não bloqueou corretamente: previsão do tempo"
        fi

        if "$HOME/.local/bin/michael-router" --dry-run "Michael agenda" 2>/dev/null | grep -qi "removido"; then
            ok "Comando removido bloqueado corretamente: agenda"
        else
            fail "Router não bloqueou corretamente: agenda"
        fi

       if "$HOME/.local/bin/michael-router" --dry-run "Michael fone" 2>/dev/null | grep -qi "removido"; then
           ok "Comando substituído pelo watchdog bloqueado corretamente: fone"
       else
           fail "Router não bloqueou corretamente: fone"
       fi

        if "$HOME/.local/bin/michael-router" --dry-run "Michael não desligar" 2>/dev/null | grep -qi "não entendi\|nao entendi"; then
            ok "Proteção contra 'não desligar' funcionando"
        else
            fail "Proteção contra 'não desligar' falhou"
        fi

        if "$HOME/.local/bin/michael-router" --dry-run "Michael desligar" 2>/dev/null | grep -qi "desligaria"; then
            ok "Dry-run de desligar funcionando"
        else
            fail "Dry-run de desligar falhou"
        fi
    fi
else
    fail "Router não está executável"
fi

section "Integração opcional: fones"

split_script="$HOME/.local/bin/split-fones.sh"
resync_script="$HOME/.local/bin/resync-fones.sh"
fones_config="$HOME/.config/linux-bluetooth-split-stereo/config"

if [ -x "$split_script" ] && [ -x "$resync_script" ]; then
   ok "linux-bluetooth-split-stereo instalado"

   if [ -f "$fones_config" ]; then
       ok "Configuração externa encontrada"
   else
       warn "Configuração externa não encontrada: $fones_config"
   fi

   watchdog_active="$(unit_active fones-watchdog.service)"
   watchdog_enabled="$(unit_enabled fones-watchdog.service)"

   if [ "$watchdog_active" = "active" ]; then
       ok "Watchdog dos fones ativo"
   else
       warn "Watchdog dos fones não está ativo: ${watchdog_active:-desconhecido}"
   fi

   if [ "$watchdog_enabled" = "enabled" ]; then
       ok "Watchdog dos fones habilitado"
   else
       warn "Watchdog dos fones não está habilitado: ${watchdog_enabled:-desconhecido}"
   fi
elif [ -e "$split_script" ] || [ -e "$resync_script" ]; then
   warn "Integração dos fones parcialmente instalada"
else
   printf "ℹ️  Integração linux-bluetooth-split-stereo não instalada\n"
fi

default_sink="indisponível"
if command -v pactl >/dev/null 2>&1; then
    default_sink="$(pactl get-default-sink 2>/dev/null || echo indisponível)"
fi

echo "Sink padrão atual: $default_sink"

section "Vosk"

if find "$HOME" -maxdepth 3 -type d -iname '*vosk*' 2>/dev/null | head -n 1 | grep -q .; then
    ok "Modelo/pasta Vosk encontrada"
else
    warn "Modelo/pasta Vosk não encontrado em busca rasa"
fi

section "Resumo"

if [ "$FAILS" -eq 0 ] && [ "$WARNS" -eq 0 ]; then
    echo "Tudo certo ✅"
elif [ "$FAILS" -eq 0 ]; then
    echo "Tudo funcional, com avisos ⚠️"
else
    echo "Há problemas para corrigir ❌"
fi

if [ "${MICHAEL_SOURCE:-manual}" != "manual" ] && command -v notify-send >/dev/null 2>&1; then
    if [ "$FAILS" -eq 0 ]; then
        notify-send "Michael Check" "Tudo certo ✅" >/dev/null 2>&1 || true
    else
        notify-send "Michael Check" "Há problemas para corrigir ❌" >/dev/null 2>&1 || true
    fi
fi

exit "$FAILS"
