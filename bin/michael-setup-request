#!/usr/bin/env bash
set -euo pipefail

source "$HOME/.local/share/michael/scripts/config.sh"

MUDAR_STATE_FILE="$STATE_DIR/mudar_active"
FORCE_SETUP="${MICHAEL_FORCE_SETUP:-0}"

if is_paused; then
    notify_cooldown "paused" 30 "Michael" "Estou pausado 💤"
    log_michael "setup-request ignorado: pausado"
    exit 0
fi

if [[ ! -x "$HOME/.local/bin/abrir-setup" ]]; then
    notify_basic "Michael" "Script abrir-setup não encontrado ou sem permissão."
    log_michael "setup-request falhou: abrir-setup ausente ou sem permissão"
    exit 1
fi

if [[ -f "$MUDAR_STATE_FILE" ]]; then
    rm -f "$MUDAR_STATE_FILE"
    FORCE_SETUP="1"
    log_michael "setup-request: modo mudar estava ativo; setup será forçado"
fi

if apps_open && [[ "$FORCE_SETUP" != "1" ]]; then
    notify_cooldown "setup_open" 20 "Michael" "Setup já parece estar aberto."
    log_michael "setup-request ignorado: apps já abertos"
    exit 0
fi

clear_pending
log_michael "setup-request: abrindo setup direto; FORCE_SETUP=$FORCE_SETUP"

MICHAEL_FORCE_SETUP="$FORCE_SETUP" exec "$HOME/.local/bin/abrir-setup"
