#!/usr/bin/env bash
set -euo pipefail

CONFIG="$HOME/.local/share/michael/scripts/config.sh"

if [ -f "$CONFIG" ]; then
    source "$CONFIG"
fi

if ! declare -F log_michael >/dev/null 2>&1; then
    log_michael() {
        local STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/michael"
        mkdir -p "$STATE_DIR"
        printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$STATE_DIR/voice-command.log"
    }
fi

TEXT="${*:-}"

if [ -z "$TEXT" ]; then
    log_michael "voz: comando vazio ignorado"
    exit 0
fi

normalize_text() {
    python3 - "$TEXT" <<'PY'
import sys
import unicodedata
import re

text = " ".join(sys.argv[1:])
text = unicodedata.normalize("NFKD", text)
text = text.encode("ascii", "ignore").decode("ascii")
text = text.lower()
text = re.sub(r"[^a-z0-9 ]+", " ", text)
text = re.sub(r"\s+", " ", text).strip()
print(text)
PY
}

NORM="$(normalize_text)"
TRUSTED="${MICHAEL_FROM_VOICE:-0}"
HAS_WAKE=0

case "$NORM" in
    *"michael"*|*"maikel"*|*"maicon"*|*"mikel"*|*"miguel"*|*"michel"*|*"miquel"*|*"maiquel"*|*"maicol"*|*"maico"*)
        HAS_WAKE=1
        ;;
esac

if [ "$TRUSTED" != "1" ] && [ "$HAS_WAKE" != "1" ]; then
    log_michael "voz bloqueada: sem wake e sem origem confiável: $TEXT"
    exit 0
fi

case "$NORM" in
    *"como voce esta"*|*"como voce ta"*|*"como ta"*|*"qual seu status"*|*"qual e seu status"*|*"qual seu estado"*|*"o que voce faz"*|*"quais comandos"*|*"lista comandos"*)
        ;;
    como\ *|*" como "*|por\ que\ *|*" por que "*|porque\ *|*" porque "*|o\ que\ *|*" o que "*|qual\ *|*" qual "*|quais\ *|*" quais "*|quando\ *|*" quando "*|onde\ *|*" onde "*|quem\ *|*" quem "*)
        log_michael "voz: pergunta ignorada para evitar ação acidental: $TEXT"
        exit 0
        ;;
esac

ROUTER="$HOME/.local/bin/michael-router"

if [ ! -x "$ROUTER" ]; then
    log_michael "erro: michael-router não encontrado ou sem permissão"
    exit 1
fi

log_michael "voz: enviando para router: $TEXT"
"$ROUTER" --source voice "$TEXT" >/dev/null 2>&1 || log_michael "voz: router retornou erro para: $TEXT"
