#!/usr/bin/env bash

set -u

unit_value() {
    local subcmd="$1"
    local unit="$2"
    local fallback="$3"
    local out

    out="$(systemctl --user "$subcmd" "$unit" 2>/dev/null | head -n 1 || true)"

    if [ -z "$out" ]; then
        out="$fallback"
    fi

    printf '%s' "$out"
}

voice_active="$(unit_value is-active michael-voice.service unknown)"
voice_enabled="$(unit_value is-enabled michael-voice.service unknown)"

jarvis_active="$(unit_value is-active jarvis-wakeword.service inactive)"
jarvis_enabled="$(unit_value is-enabled jarvis-wakeword.service disabled)"

clap_active="$(unit_value is-active michael-clap.service inactive)"
clap_enabled="$(unit_value is-enabled michael-clap.service disabled)"

router_status="não encontrado"
if [ -x "$HOME/.local/bin/michael-router" ]; then
    router_status="ok"
fi

terminal_status="não encontrado"
if [ -x "$HOME/.local/bin/michael" ]; then
    terminal_status="ok"
fi

setup_aberto="não"
if command -v hyprctl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
    if hyprctl clients -j 2>/dev/null | jq -e '
        .[] | select(
            (.class | test("zen|zen-browser|chrome-cinhimbnkkaeohfgghhklpknlkffjgod-Default|chrome-hnpfjngllnobngcgfapefoaidbinmjnm-Default"; "i"))
            or
            (.title | test("Zen|YouTube Music|WhatsApp"; "i"))
        )
    ' >/dev/null 2>&1; then
        setup_aberto="sim"
    fi
fi

ydotool_status="não instalado"
if command -v ydotool >/dev/null 2>&1; then
    ydotool_status="instalado"
fi

playerctl_status="não instalado"
if command -v playerctl >/dev/null 2>&1; then
    playerctl_status="instalado"
fi

audio_processes="$(pgrep -af 'michael_voice.py|vosk' 2>/dev/null || true)"
audio_count="$(printf '%s\n' "$audio_processes" | sed '/^$/d' | wc -l)"

default_sink="indisponível"
if command -v pactl >/dev/null 2>&1; then
    default_sink="$(pactl get-default-sink 2>/dev/null || echo indisponível)"
fi

cat <<TXT
Michael 2.0 Status
==================

Serviço principal:     ${voice_active} / ${voice_enabled}
Router seguro:         ${router_status}
Modo terminal:         ${terminal_status}

Voz antiga/Jarvis:     ${jarvis_active} / ${jarvis_enabled}
Palmas:                ${clap_active} / ${clap_enabled}

Setup aberto:          ${setup_aberto}
ydotool:               ${ydotool_status}
playerctl:             ${playerctl_status}

Sink padrão:           ${default_sink}
Processos de áudio:    ${audio_count}

Comandos removidos:    música, pausar, voltar, tempo, agenda
TXT

if [ -n "$audio_processes" ]; then
    echo
    echo "Processos:"
    printf '%s\n' "$audio_processes"
fi
