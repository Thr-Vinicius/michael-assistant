#!/usr/bin/env bash
set -euo pipefail

source "$HOME/.local/share/michael/scripts/config.sh"

LOCK_FILE="$MICHAEL_RUNTIME_DIR/resolver-fones.lock"
FONE_LOG="$LOG_DIR/fones.log"

if command -v flock >/dev/null 2>&1; then
    exec 9>"$LOCK_FILE"
    if ! flock -n 9; then
        notify_cooldown "resolver_running" 10 "Michael" "Já estou ressincrozando os fones."
        log_michael "resolver cancelado: outro processo já está rodando"
        exit 0
    fi
fi

RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}"

REQUEST_FLAG="$RUNTIME_DIR/fones-watchdog-resync-request-${UID}.flag"

if ! declare -F notify_basic >/dev/null; then
    notify_basic() {
        command -v notify-send >/dev/null 2>&1 &&
            notify-send "$1" "$2"
    }
fi

if ! declare -F log_michael >/dev/null; then
    log_michael() {
        local log_dir="$HOME/.local/share/michael/logs"

        mkdir -p "$log_dir"

        printf '[%(%F %T)T] %s\n' -1 "$*" \
            >> "$log_dir/fones.log"
    }
fi

# A manual resync only makes sense when both configured
# Bluetooth headphones are currently available.
CONFIG_FILE="${BLUETOOTH_SPLIT_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/linux-bluetooth-split-stereo/config}"

if [[ -r "$CONFIG_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$CONFIG_FILE"
fi

if [[ -z "${LEFT_DEVICE:-}" ||
      -z "${RIGHT_DEVICE:-}" ]]; then

    notify_basic \
        "Michael" \
        "A configuração dos fones não foi encontrada."

    log_michael \
        "resolver ignorado: configuração dos fones ausente"

    exit 0
fi

sinks="$(pactl list short sinks 2>/dev/null || true)"

left_connected=0
right_connected=0

awk -v target="$LEFT_DEVICE" '
    $2 == target {
        found = 1
    }

    END {
        exit(found ? 0 : 1)
    }
' <<< "$sinks" && left_connected=1

awk -v target="$RIGHT_DEVICE" '
    $2 == target {
        found = 1
    }

    END {
        exit(found ? 0 : 1)
    }
' <<< "$sinks" && right_connected=1

if (( left_connected == 0 ||
      right_connected == 0 )); then

    notify_basic \
        "Michael" \
        "Conecte os dois fones antes de pedir a ressincronização."

    log_michael \
        "resolver ignorado: os dois fones não estão conectados"

    exit 0
fi

: > "$REQUEST_FLAG"

if ! systemctl --user is-active --quiet \
    fones-watchdog.service; then

    if ! systemctl --user start \
        fones-watchdog.service; then

        rm -f "$REQUEST_FLAG"

        notify_basic \
            "Michael" \
            "Não consegui iniciar o supervisor dos fones."

        log_michael \
            "resolver falhou: watchdog não iniciou"

        exit 1
    fi
fi

notify_basic \
    "Michael" \
    "Ressincronização dos fones solicitada."

log_michael \
    "resolver solicitou resync ao watchdog"

exit 0
