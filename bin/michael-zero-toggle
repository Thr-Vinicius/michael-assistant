#!/usr/bin/env bash

set -u

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/michael"
LOG_FILE="$STATE_DIR/zero.log"

mkdir -p "$STATE_DIR"

log() {
    printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG_FILE"
}

notify() {
    if command -v notify-send >/dev/null 2>&1; then
        notify-send "$1" "$2" >/dev/null 2>&1 || true
    fi
}

stop_caelestia() {
    pkill -f '^qs -c overview$' >/dev/null 2>&1 || true
    pkill -f '^qs -c caelestia ' >/dev/null 2>&1 || true
    log "Caelestia e overview encerrados"
}

start_caelestia() {
    if ! pgrep -f '^qs -c caelestia ' >/dev/null 2>&1; then
        caelestia shell -d >/dev/null 2>&1 &
    fi

    if ! pgrep -f '^qs -c overview$' >/dev/null 2>&1; then
        qs -c overview >/dev/null 2>&1 &
    fi

    log "Caelestia e overview iniciados"
}

SERVICE="michael-voice.service"

if systemctl --user is-active --quiet "$SERVICE"; then
    systemctl --user stop "$SERVICE" >/dev/null 2>&1

    if systemctl --user is-active --quiet "$SERVICE"; then
        notify "Michael Zero" "Não consegui parar a escuta."
        log "erro ao parar $SERVICE"
        exit 1
    fi

    stop_caelestia

    notify "Michael Zero" "Modo game ativado. Michael e Caelestia desligados."
    log "modo game ativado; serviço parado: $SERVICE"
else
    systemctl --user start "$SERVICE" >/dev/null 2>&1

    if systemctl --user is-active --quiet "$SERVICE"; then
        start_caelestia

        notify "Michael Zero" "Modo game desativado. Michael e Caelestia reativados."
        log "modo game desativado; serviço iniciado: $SERVICE"
        exit 0
    fi

    notify "Michael Zero" "Não consegui iniciar a escuta."
    log "erro ao iniciar $SERVICE"
    exit 1
fi
