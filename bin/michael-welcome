#!/usr/bin/env bash
set -euo pipefail

source "$HOME/.local/share/michael/scripts/config.sh"

INTRO_AUDIO="${MICHAEL_START_AUDIO:-$HOME/audios-michael/inic.mp3}"
LOCK_FILE="$MICHAEL_RUNTIME_DIR/welcome.lock"

play_blocking() {
    local file="$1"

    [[ -f "$file" ]] || {
        log_michael "welcome: áudio não encontrado: $file"
        return 1
    }

    if command -v mpv >/dev/null 2>&1; then
        mpv --no-terminal --really-quiet "$file" >/dev/null 2>&1 || true
        return 0
    fi

    if command -v ffplay >/dev/null 2>&1; then
        ffplay -nodisp -autoexit -loglevel quiet "$file" >/dev/null 2>&1 || true
        return 0
    fi

    if command -v paplay >/dev/null 2>&1; then
        paplay "$file" >/dev/null 2>&1 || true
        return 0
    fi

    log_michael "welcome: nenhum player disponível"
    return 1
}

if command -v flock >/dev/null 2>&1; then
    exec 9>"$LOCK_FILE"
    if ! flock -n 9; then
        log_michael "welcome ignorado: outro welcome já está rodando"
        exit 0
    fi
fi

sleep 5

log_michael "welcome iniciado pelo boot/login"

set_system_volume "30%"
sleep 0.2

play_blocking "$INTRO_AUDIO"

set_system_volume "30%"
log_michael "welcome finalizado; volume mantido em 30%"
