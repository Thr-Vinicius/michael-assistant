# /home/arthur/.config/systemd/user/michael-voice.service
[Unit]
Description=Michael voice listener
After=graphical-session.target

[Service]
Type=simple
ExecStart=/home/arthur/.venvs/jarvis/bin/python /home/arthur/michael_voice.py
Restart=always
RestartSec=2
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target

# /home/arthur/.config/systemd/user/michael-voice.service.d/audio.conf
[Service]
Environment=MICHAEL_ACTIVATION_AUDIO=/home/arthur/audios-michael/conf_1_som.mp3
